# Copy to .dev.vars for local Vinext/Cloudflare development.
# Run `ollama serve` separately, then `ollama pull qwen2.5:1.5b` if needed.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
# Hosted deployment: set these through Sites runtime environment settings.
# The hosted Worker needs a securely reachable inference service; localhost refers to the Worker.
